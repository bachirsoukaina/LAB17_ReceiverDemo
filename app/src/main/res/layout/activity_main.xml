<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ReceiverDemo"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/labelNetworkState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ecoute mode avion : INACTIVE"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnNetworkToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Demarrer ecoute"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnFireAlert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Envoyer Broadcast"/>

</LinearLayout>